rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Projects: Full read, create, update, delete
    match /projects/{projectId} {
      allow read, write: if true;
    }

    // Donations: Full read, create, update, delete
    match /donations/{donationId} {
      allow read, write: if true;
    }

    // Volunteer registrations: Full read, create, update, delete
    match /volunteers/{volunteerId} {
      allow read, write: if true;
    }

    // Impact stats: Full read, create, update, delete
    match /stats/{statId} {
      allow read, write: if true;
    }

    // News: Full read, create, update, delete
    match /news/{newsId} {
      allow read, write: if true;
    }

    // Site settings: Full read, create, update, delete
    match /settings/{settingId} {
      allow read, write: if true;
    }

    // Admins collection
    match /admins/{adminId} {
      allow read, write: if true;
    }

    // Test connection doc
    match /test/{docId} {
      allow read, write: if true;
    }

    // Fallback
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
