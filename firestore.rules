rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'ahmedabdelbaseer944@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Projects: Public read, admin write
    match /projects/{projectId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Donations: Public create (donors donating), admin read and manage
    match /donations/{donationId} {
      allow create: if request.resource.data.amount > 0 && request.resource.data.paymentMethod is string;
      allow read, update, delete: if isAdmin();
    }

    // Volunteer registrations: Public create, admin read and manage
    match /volunteers/{volunteerId} {
      allow create: if request.resource.data.fullName is string && request.resource.data.phone is string;
      allow read, update, delete: if isAdmin();
    }

    // Impact stats: Public read, admin write
    match /stats/{statId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // News: Public read, admin write
    match /news/{newsId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Site settings: Public read, admin write
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Admins collection: strictly protected
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Test connection doc
    match /test/{docId} {
      allow read: if true;
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
